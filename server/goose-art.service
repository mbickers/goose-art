[Unit]
Description=Goose Art server
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=%h/goose-art/server
# bound to loopback: exe.dev terminates TLS and reverse proxies here
ExecStart=%h/goose-art/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
