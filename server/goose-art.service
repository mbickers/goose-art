[Unit]
Description=Goose Art server
After=network.target

[Service]
WorkingDirectory=/opt/goose-art
# bound to loopback: Caddy terminates TLS and reverse proxies here
ExecStart=/opt/goose-art/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
