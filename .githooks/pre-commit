#!/bin/sh
# Formats staged Python files with ruff before commit.
set -eu

staged_py_files=$(git diff --cached --name-only --diff-filter=ACM -- 'server/*.py')

if [ -z "$staged_py_files" ]; then
    exit 0
fi

(cd server && uv run ruff format -- $(echo "$staged_py_files" | sed 's|^server/||'))
(cd server && uv run ruff check --fix -- $(echo "$staged_py_files" | sed 's|^server/||'))

echo "$staged_py_files" | xargs git add
